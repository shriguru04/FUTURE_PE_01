# --- Demo mode needs NOTHING here. Leave this file untouched to run offline. ---

# Browser-visible: only the URL of your proxy. Never put a provider key in a VITE_ variable.
VITE_AI_PROXY_URL=/api/generate

# Server-only (read by server/proxy.mjs, never bundled into the frontend):
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Optional model overrides
ANTHROPIC_MODEL=claude-sonnet-5-5
OPENAI_MODEL=gpt-4o-mini
PORT=8787
